{
  "bundle": {
    "targets": [
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/128x128.png",
      "icons/icon.png"
    ],
    "resources": {
      "resources/rdt_voice_backend": "rdt_voice_backend",
      "resources/rdt_voice_web": "rdt_voice_web",
      "resources/linux-third-party-notices": "third_party_notices",
      "resources/Credits.html": "Credits.html"
    },
    "linux": {
      "deb": {
        "depends": [
          "libvulkan1",
          "libayatana-appindicator3-1"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://raw.githubusercontent.com/RolanDorisTech/rdt-voice/main/rdt_connect/updates/dev/{{target}}/{{arch}}/latest.json"
      ]
    }
  }
}
