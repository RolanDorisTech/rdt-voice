{
  "name": "rdt-connect-desktop",
  "private": true,
  "version": "0.2.0-dev.11.4U.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "tsc && vite build",
    "tauri": "tauri",
    "prepare:desktop-resources": "bash scripts/prepare-macos-bundle.sh ..",
    "build:desktop:macos": "bash scripts/build-macos-with-marker.sh",
    "build:custom-dmg": "python3 scripts/build-custom-dmg.py",
    "build:desktop:custom-dmg:macos": "RDT_BUILD_APP_ONLY=1 RDT_SKIP_UPDATER_ARTIFACTS=1 bash scripts/build-macos-with-marker.sh && python3 scripts/build-custom-dmg.py",
    "test:versioning": "node scripts/test-build-versioning.cjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.4",
    "semver": "7.8.5",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
