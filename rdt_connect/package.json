{
  "allowScripts": {
    "esbuild@0.25.12": true
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.4",
    "semver": "7.8.5",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  },
  "name": "rdt-connect-desktop",
  "private": true,
  "scripts": {
    "build": "node scripts/test-frontend-runtime-identifiers.cjs && tsc && vite build",
    "build:custom-dmg": "bash scripts/run-release-contracts.sh && python3 scripts/build-custom-dmg.py",
    "build:desktop:custom-dmg:macos": "RDT_SKIP_UPDATER_ARTIFACTS=1 RDT_BUILD_APP_ONLY=1 bash scripts/build-macos-with-marker.sh && python3 scripts/build-custom-dmg.py",
    "build:desktop:macos": "bash scripts/build-macos-with-marker.sh",
    "dev": "vite --host 127.0.0.1 --port 1420",
    "prebuild": "node scripts/check-embedded-rdt-voice.mjs",
    "prepare:desktop-resources": "bash scripts/prepare-macos-bundle.sh ..",
    "sync:build-version": "node scripts/sync-build-version.cjs .",
    "tauri": "tauri",
    "test:release-contracts": "bash scripts/run-release-contracts.sh",
    "test:versioning": "node scripts/test-build-versioning.cjs"
  },
  "type": "module",
  "version": "0.2.0-dev.12.1D47"
}
